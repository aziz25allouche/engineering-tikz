\begin{tikzpicture}[petrinet]
  %% Places  (coord. calculees par Python depuis Pre/Post)
  \node[place,label=right:$P_1$] (p0) at (-2.0,-2.5) {};
  \petritokens{p0}{1}
  \node[place,label=right:$P_2$] (p1) at (0.0,-2.5) {};
  \node[place,label=right:$P_3$] (p2) at (0.0,-7.5) {};
  \node[place,label=right:$P_4$] (p3) at (-2.2,-7.5) {};
  \petritokens{p3}{1}
  \node[place,label=right:$P_5$] (p4) at (-6.4,-2.5) {};
  \petritokens{p4}{1}
  \node[place,label=right:$P_6$] (p5) at (-4.4,-2.5) {};
  \node[place,label=right:$P_7$] (p6) at (-4.4,-7.5) {};
  %% Transitions
  \node[transition,label=above:$T_1$,rotate=90, anchor=center] (t0) at (0.0,-0.0) {};
  \node[transition,label=above:$T_2$,rotate=90, anchor=center] (t1) at (0.0,-5.0) {};
  \node[transition,label=above:$T_3$,rotate=90, anchor=center] (t2) at (0.0,-10.0) {};
  \node[transition,label=above:$T_4$,rotate=90, anchor=center] (t3) at (-4.4,-0.0) {};
  \node[transition,label=above:$T_5$,rotate=90, anchor=center] (t4) at (-4.4,-5.0) {};
  \node[transition,label=above:$T_6$,rotate=90, anchor=center] (t5) at (-4.4,-10.0) {};
  %% Arcs Pre  P->T
  \draw[arc] (p0) --  (t0);
  \draw[arc] (p1) --  (t1);
  \draw[arc] (p3) --  (t1);
  \draw[arc] (p2) --  (t2);
  \draw[arc] (p4) --  (t3);
  \draw[arc] (p3) --  (t4);
  \draw[arc] (p5) --  (t4);
  \draw[arc] (p6) --  (t5);
  %% Arcs Post T->P
  \draw[arc] (t0) --  (p1);
  \draw[arc] (t1) --  (p0);
  \draw[arc] (t1) --  (p2);
  \draw[arc] (t2) --  (p3);
  \draw[arc] (t3) --  (p5);
  \draw[arc] (t4) --  (p4);
  \draw[arc] (t4) --  (p6);
  \draw[arc] (t5) --  (p3);
\end{tikzpicture}
