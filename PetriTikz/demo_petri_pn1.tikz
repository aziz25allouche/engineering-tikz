\begin{tikzpicture}[petrinet]
  %% Places  (coord. calculees par Python depuis Pre/Post)
  \node[place,label=right:$P_1$] (p0) at (-0.0,-2.5) {};
  \petritokens{p0}{1}
  \node[place,label=right:$P_2$] (p1) at (2.0,-2.5) {};
  \node[place,label=right:$P_3$] (p2) at (-0.0,-7.5) {};
  \petritokens{p2}{1}
  \node[place,label=right:$P_4$] (p3) at (2.0,-7.5) {};
  %% Transitions
  \node[transition,label=above:$T_1$,rotate=90, anchor=center] (t0) at (-0.0,0.0) {};
  \node[transition,label=above:$T_2$,rotate=90, anchor=center] (t1) at (-0.0,-5.0) {};
  \node[transition,label=above:$T_3$,rotate=90, anchor=center] (t2) at (-0.0,-10.0) {};
  %% Arcs Pre  P->T
  \draw[arc] (p1) -- (t0);
  \draw[arc] (p0) -- (t1);
  \draw[arc] (p3) -- (t1);
  \draw[arc] (p2) -- (t2);
  %% Arcs Post T->P
  \draw[arc] (t0) --  (p0);
  \draw[arc] (t1) --  (p1);
  \draw[arc] (t1) --  (p2);
  \draw[arc] (t2) --  (p3);
\end{tikzpicture}
