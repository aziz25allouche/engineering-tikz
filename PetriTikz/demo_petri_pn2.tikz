\begin{tikzpicture}[petrinet]
  %% Places  (coord. calculees par Python depuis Pre/Post)
  \node[place,label=above:$P_1$] (p0) at (2.5,0.0) {};
  \petritokens{p0}{1}
  \node[place,label=above:$P_2$] (p1) at (2.5,-2.0) {};
  \node[place,label=above:$P_3$] (p2) at (7.5,0.0) {};
  \petritokens{p2}{1}
  \node[place,label=above:$P_4$] (p3) at (7.5,-2.0) {};
  %% Transitions
  \node[transition,label=above:$T_1$] (t0) at (0.0,0.0) {};
  \node[transition,label=above:$T_2$] (t1) at (5.0,0.0) {};
  \node[transition,label=above:$T_3$] (t2) at (10.0,0.0) {};
  %% Arcs Pre  P->T
  \draw[arc] (p1) --  (t0);
  \draw[arc] (p0) --  (t1);
  \draw[arc] (p3) --  (t1);
  \draw[arc] (p2) --  (t2);
  %% Arcs Post T->P
  \draw[arc] (t0) --  (p0);
  \draw[arc] (t1) --  (p1);
  \draw[arc] (t1) --  (p2);
  \draw[arc] (t2) --  (p3);
\end{tikzpicture}
