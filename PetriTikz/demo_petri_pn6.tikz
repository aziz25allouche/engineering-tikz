\begin{tikzpicture}[petrinet]
  %% Places  (coord. calculees par Python depuis Pre/Post)
  \node[place,label=above:libre] (p0) at (-2.741,-0.267) {};
  \petritokens{p0}{1}
  \node[place,label=above:produit] (p1) at (-0.0,-3.305) {};
  \node[place,label=above:vide] (p2) at (2.741,-0.267) {};
  \petritokens{p2}{1}
  \node[place,label=above:plein] (p3) at (-0.0,4.541) {};
  %% Transitions
  \node[enabled transition,label=above:produire] (t0) at (-0.0,-1.543) {};
  \node[transition,label=above:consommer] (t1) at (-0.0,0.84) {};
  %% Arcs Pre  P->T
  \draw[arc] (p0) -- (t0);
  \draw[->, bend left=60] (p1) to node[midway] {} (t1);
  \draw[->, bend left=60] (p2) to node[midway] {} (t1);
  %% Arcs Post T->P
  \draw[->, bend left=60] (t0) to node[midway] {} (p1);
  \draw[arc] (t0) --  (p2);
  \draw[->, bend left=60] (t1) to node[midway] {} (p0);
  \draw[->, bend left=60] (t1) to node[midway] {} (p3);
\end{tikzpicture}
