\begin{tikzpicture}[petrinet]
  %% Places  (coord. calculees par Python depuis Pre/Post)
  \node[place,label=above:$P_1$] (p0) at (-2.5,0.0) {};
  \petritokens{p0}{1}
  \node[place,label=above:$P_2$] (p1) at (2.5,1.1) {};
  \node[place,label=above:$P_3$] (p2) at (2.5,-1.1) {};
  %% Transitions
  \node[transition,label=above:$T_1$] (t0) at (0.0,0.0) {};
  \node[transition,label=above:$T_2$] (t1) at (5.0,0.0) {};
  %% Arcs Pre  P->T
  \draw[arc] (p0) --  (t0);
  \draw[arc] (p1) --  (t1);
  \draw[arc] (p2) --  (t1);
  %% Arcs Post T->P
  \draw[arc,red] (t0) to [bend left]  node[weight]{2} (p0);
  \draw[arc] (t0) --  (p1);
  \draw[arc] (t0) --  (p2);
\end{tikzpicture}
