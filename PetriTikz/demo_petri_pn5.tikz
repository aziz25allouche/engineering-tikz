\begin{tikzpicture}[petrinet]
  %% Places  (coord. calculees par Python depuis Pre/Post)
  \node[place,label=right:$P_1$] (p0) at (0.0,2.5) {};
  \petritokens{p0}{1}
  \node[place,label=right:$P_2$] (p1) at (1.1,-2.5) {};
  \node[place,label=right:$P_3$] (p2) at (-1.1,-2.5) {};
  %% Transitions
  \node[transition,label=above:$T_1$,rotate=90, anchor=center] (t0) at (0.0,-0.0) {};
  \node[transition,label=above:$T_2$,rotate=90, anchor=center] (t1) at (0.0,-5.0) {};
  %% Arcs Pre  P->T
  \draw[arc] (p0) --  (t0);
  \draw[arc] (p1) --  (t1);
  \draw[arc] (p2) --  (t1);
  %% Arcs Post T->P
  \draw[arc,red] (t0) to [bend left]  node[weight]{2} (p0);
  \draw[arc] (t0) --  (p1);
  \draw[arc] (t0) --  (p2);
\end{tikzpicture}
