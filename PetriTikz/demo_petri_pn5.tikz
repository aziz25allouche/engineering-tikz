\begin{tikzpicture}[petrinet]
  %% Places  (coord. calculees par Python depuis Pre/Post)
  \node[place,label=above:attente1] (p0) at (0.0,4.0) {};
  \petritokens{p0}{1}
  \node[place,label=above:attente2] (p1) at (0.0,2.0) {};
  \petritokens{p1}{1}
  \node[place,label=above:mutex] (p2) at (0.0,0.0) {};
  \petritokens{p2}{1}
  \node[place,label=above:SC1] (p3) at (0.0,-2.0) {};
  \node[place,label=above:SC2] (p4) at (0.0,-4.0) {};
  %% Transitions
  \node[enabled transition,label=below:entrer1] (t0) at (5.0,3.0) {};
  \node[transition,label=below:sortir1] (t1) at (5.0,1.0) {};
  \node[enabled transition,label=below:entrer2] (t2) at (5.0,-1.0) {};
  \node[transition,label=below:sortir2] (t3) at (5.0,-3.0) {};
  %% Arcs Pre  P->T
  \draw[arc] (p0) -- (t0);
  \draw[arc] (p2) -- (t0);
  \draw[arc] (p3) -- (t1);
  \draw[arc] (p1) -- (t2);
  \draw[arc] (p2) -- (t2);
  \draw[arc] (p4) -- (t3);
  %% Arcs Post T->P
  \draw[arc] (t0) -- (p3);
  \draw[arc] (t1) -- (p0);
  \draw[arc] (t1) -- (p2);
  \draw[arc] (t2) -- (p4);
  \draw[arc] (t3) -- (p1);
  \draw[arc] (t3) -- (p2);
\end{tikzpicture}
