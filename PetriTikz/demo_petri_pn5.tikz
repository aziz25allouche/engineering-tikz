\begin{tikzpicture}[petrinet]
  %% Places  (coord. calculees par Python depuis Pre/Post)
  \node[place,label=above:attente1] (p0) at (-4.0,0.0) {};
  \petritokens{p0}{1}
  \node[place,label=above:attente2] (p1) at (-2.0,0.0) {};
  \petritokens{p1}{1}
  \node[place,label=above:mutex] (p2) at (-0.0,0.0) {};
  \petritokens{p2}{1}
  \node[place,label=above:SC1] (p3) at (2.0,0.0) {};
  \node[place,label=above:SC2] (p4) at (4.0,0.0) {};
  %% Transitions
  \node[enabled transition,label=above:entrer1] (t0) at (-3.0,5.0) {};
  \node[transition,label=above:sortir1] (t1) at (-1.0,5.0) {};
  \node[enabled transition,label=above:entrer2] (t2) at (1.0,5.0) {};
  \node[transition,label=above:sortir2] (t3) at (3.0,5.0) {};
  %% Arcs Pre  P->T
  \draw[arc] (p0) -- (t0);
  \draw[->, bend left=60] (p2) to node[midway] {} (t0);
  \draw[->, bend left=60] (p3) to node[midway] {} (t1);
  \draw[arc] (p1) -- (t2);
  \draw[arc] (p2) -- (t2);
  \draw[->, bend left=60] (p4) to node[midway] {} (t3);
  %% Arcs Post T->P
  \draw[arc] (t0) --  (p3);
  \draw[->, bend left=60] (t1) to node[midway] {} (p0);
  \draw[arc] (t1) --  (p2);
  \draw[arc] (t2) --  (p4);
  \draw[->, bend left=60] (t3) to node[midway] {} (p1);
  \draw[->, bend left=60] (t3) to node[midway] {} (p2);
\end{tikzpicture}
