\begin{tikzpicture}[petrinet]
  %% Places  (coord. calculees par Python depuis Pre/Post)
  \node[place,label=above:libre] (p0) at (-2.0,-3.75) {};
  \petritokens{p0}{1}
  \node[place,label=above:produit] (p1) at (-2.0,-1.25) {};
  \node[place,label=above:vide] (p2) at (-2.0,1.25) {};
  \petritokens{p2}{1}
  \node[place,label=above:plein] (p3) at (-2.0,3.75) {};
  %% Transitions
  \node[enabled transition,label=above:produire] (t0) at (-0.0,-1.25) {};
  \node[transition,label=above:consommer] (t1) at (-0.0,0.0) {};
  %% Arcs Pre  P->T
  \draw[arc] (p0) -- (t0);
  \draw[arc] (p1) -- (t1);
  \draw[arc] (p2) -- (t1);
  %% Arcs Post T->P
  \draw[->, bend left=60] (t0) to node[midway] {} (p1);
  \draw[->, bend left=60] (t0) to node[midway] {} (p2);
  \draw[->, bend left=60] (t1) to node[midway] {} (p0);
  \draw[->, bend left=60] (t1) to node[midway] {} (p3);
\end{tikzpicture}
