%%   transition,enabled -- transition franchissable (remplie)
%%
%% Commandes de marquage :
%%   tokens=N         -- N jetons dans la place (N ∈ {1,...,6})
%%
%% Commandes de dessin :
%%   \draw[arc]       -- arc orienté
%%   \draw[inhibitor] -- arc inhibiteur (cercle terminal)

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{PetriTikz}[2024/01/01 v1.0 PetriTikz - Réseaux de Petri avec TikZ]

\RequirePackage{tikz}
\RequirePackage{xcolor}
\RequirePackage{ifthen}
\RequirePackage{calc}

\usetikzlibrary{arrows.meta, shapes.geometric, positioning,
                decorations.pathmorphing, calc, fit, backgrounds}

%% ─────────────────────────────────────────────
%%  Palette de couleurs
%% ─────────────────────────────────────────────
\definecolor{ptPlaceFill}      {RGB}{220,235,255}
\definecolor{ptPlaceBorder}    {RGB}{ 30, 80,160}
\definecolor{ptTransFill}      {RGB}{255,235,200}
\definecolor{ptTransBorder}    {RGB}{180, 80,  0}
\definecolor{ptEnabledFill}    {RGB}{ 80,180, 80}
\definecolor{ptEnabledBorder}  {RGB}{ 20,100, 20}
\definecolor{ptTokenColor}     {RGB}{ 20, 40,120}
\definecolor{ptArcColor}       {RGB}{ 50, 50, 50}
\definecolor{ptWeightColor}    {RGB}{150,  0,  0}
\definecolor{ptInhibitorColor} {RGB}{180, 20, 20}

%% ─────────────────────────────────────────────
%%  Clé « tokens » avec rendu automatique
%% ─────────────────────────────────────────────
\pgfkeys{
  /tikz/tokens/.style={
    /tikz/append after command={%
      \pgfextra{%
        \let\currentnode\tikzlastnode
        \petritikz@drawtokens{##1}{\currentnode}% <-- Added extra #
      }%
    }%
  }
}


%% Macro interne : dessine les jetons selon leur nombre
\newcommand{\petritikz@drawtokens}[2]{%
  \ifthenelse{#1 = 1}{%
    \fill[ptTokenColor] (#2) circle (2.5pt);
  }{%
  \ifthenelse{#1 = 2}{%
    \fill[ptTokenColor] ([xshift=-5pt]#2) circle (2pt)
                        ([xshift= 5pt]#2) circle (2pt);
  }{%
  \ifthenelse{#1 = 3}{%
    \fill[ptTokenColor] ([xshift=-5pt,yshift=-3pt]#2) circle (2pt)
                        ([xshift= 5pt,yshift=-3pt]#2) circle (2pt)
                        ([yshift= 4pt]#2)              circle (2pt);
  }{%
  \ifthenelse{#1 = 4}{%
    \fill[ptTokenColor] ([xshift=-5pt,yshift=-4pt]#2) circle (1.8pt)
                        ([xshift= 5pt,yshift=-4pt]#2) circle (1.8pt)
                        ([xshift=-5pt,yshift= 4pt]#2) circle (1.8pt)
                        ([xshift= 5pt,yshift= 4pt]#2) circle (1.8pt);
  }{%
  \ifthenelse{#1 = 5}{%
    \fill[ptTokenColor] ([xshift=-5pt,yshift=-4pt]#2) circle (1.5pt)
                        ([xshift= 5pt,yshift=-4pt]#2) circle (1.5pt)
                        ([xshift=-5pt,yshift= 4pt]#2) circle (1.5pt)
                        ([xshift= 5pt,yshift= 4pt]#2) circle (1.5pt)
                        (#2)                           circle (1.5pt);
  }{%
    % 6+ jetons : chiffre centré
    \node[ptTokenColor, font=\footnotesize\bfseries] at (#2) {#1};
  }}}}}%
}

