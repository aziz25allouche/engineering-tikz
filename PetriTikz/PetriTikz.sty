%% petritikz.sty
%% Commande principale :
%%
%%   \petrinet[layout=circle]{--pre 1,0;0,1 --post 0,1;1,0
%%             --places libre,produit --trans produire,consommer
%%             --marking 1,0}
%%
%% Appelle python petritikz.py avec les arguments passes,
%% ecrit le tikzpicture dans un fichier temporaire, puis l'inclut.
%% Requiert --shell-escape a la compilation.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{petritikz}[2025/01/01 v4.0 PetriTikz]

\RequirePackage{tikz}
\RequirePackage{xcolor}
\RequirePackage{ifthen}
\RequirePackage{keyval}

\usetikzlibrary{arrows.meta,shapes.geometric,positioning,calc,fit,backgrounds}

%% ── Couleurs ──────────────────────────────────────────────────────
\definecolor{ptPlaceFill}    {RGB}{220,235,255}
\definecolor{ptPlaceBorder}  {RGB}{ 30, 80,160}
\definecolor{ptTransFill}    {RGB}{255,235,200}
\definecolor{ptTransBorder}  {RGB}{180, 80,  0}
\definecolor{ptEnabledFill}  {RGB}{ 80,180, 80}
\definecolor{ptEnabledBorder}{RGB}{ 20,100, 20}
\definecolor{ptTokenColor}   {RGB}{ 20, 40,120}
\definecolor{ptArcColor}     {RGB}{ 50, 50, 50}
\definecolor{ptWeightColor}  {RGB}{150,  0,  0}
\definecolor{ptErrorColor}   {RGB}{200,  0,  0}

%% ── Styles TikZ ───────────────────────────────────────────────────
\tikzset{
  petrinet/.style={
    node distance=2cm,
    thick,
  },
  place/.style={
    circle,
    draw=ptPlaceBorder,
    fill=ptPlaceFill,
    line width=1.2pt,
    minimum size=24pt,
    inner sep=0pt,
  },
  enabled place/.style={
    circle,
    draw=ptEnabledBorder,
    fill=ptEnabledFill!40,
    line width=1.6pt,
    minimum size=24pt,
    inner sep=0pt,
  },
  transition/.style={
    rectangle,
    draw=ptTransBorder,
    fill=ptTransFill,
    line width=1.2pt,
    minimum height=24pt,
    minimum width=8pt,
    inner sep=0pt,
  },
  enabled transition/.style={
    rectangle,
    draw=ptEnabledBorder,
    fill=ptEnabledFill,
    line width=1.6pt,
    minimum height=24pt,
    minimum width=8pt,
    inner sep=0pt,
  },
  timed transition/.style={
    rectangle,
    draw=ptTransBorder,
    fill=ptTransFill!60,
    line width=1.2pt,
    minimum height=24pt,
    minimum width=8pt,
    inner sep=0pt,
    double,
    double distance=1.5pt,
  },
  weight/.style={
    font=\footnotesize\bfseries,
    text=ptWeightColor,
    fill=white,
    inner sep=1.5pt,
    midway,
  },
  subnet/.style={
    draw=gray!60,
    dashed,
    fill=gray!5,
    inner sep=8pt,
  },
}

%% Fleches definies hors tikzset (evite conflit pgfkeys)
\tikzstyle{arc}=[
  draw=ptArcColor,
  ->,>=latex,
  line width=1pt,
  shorten >=2pt,
  shorten <=2pt
]
\tikzstyle{inhibitor}=[
  draw=ptArcColor,
  -o,
  line width=1pt,
  shorten >=2pt,
  shorten <=2pt,
  dashed
]

%% ── Commande \petritokens{noeud}{N} ──────────────────────────────
%% Appelee par le code genere par Python pour dessiner N jetons
\newcommand{\petritokens}[2]{%
  \ifnum#2=1
    \fill[ptTokenColor] (#1) circle (2.5pt);%
  \else\ifnum#2=2
    \fill[ptTokenColor] ([xshift=-5pt]#1) circle (2pt)
                        ([xshift= 5pt]#1) circle (2pt);%
  \else\ifnum#2=3
    \fill[ptTokenColor] ([xshift=-5pt,yshift=-3pt]#1) circle (2pt)
                        ([xshift= 5pt,yshift=-3pt]#1) circle (2pt)
                        ([yshift=4pt]#1)               circle (2pt);%
  \else\ifnum#2=4
    \fill[ptTokenColor] ([xshift=-5pt,yshift=-4pt]#1) circle (1.8pt)
                        ([xshift= 5pt,yshift=-4pt]#1) circle (1.8pt)
                        ([xshift=-5pt,yshift= 4pt]#1) circle (1.8pt)
                        ([xshift= 5pt,yshift= 4pt]#1) circle (1.8pt);%
  \else
    \node[text=ptTokenColor,font=\footnotesize\bfseries] at (#1) {#2};%
  \fi\fi\fi\fi
}

%% ── Commande principale \petrinet ────────────────────────────────
%%
%% \petrinet{--pre 1,0,0,0;0,1,1,0 --post 0,1,1,0;1,0,0,1
%%           --places libre,produit,vide,plein
%%           --trans  produire,consommer
%%           --marking 1,0,1,0  --layout circle}
%%
%% Parametres (passes directement a petritikz.py) :
%%   --pre     LIGNES   matrice Pre  (lignes par ; valeurs par ,)
%%   --post    LIGNES   matrice Post (meme format)
%%   --places  LABELS   labels des places separes par virgule
%%   --trans   LABELS   labels des transitions
%%   --marking VALEURS  marquage initial separe par virgule
%%   --layout  NOM      circle | bipartite | grid | force
%%
\newcounter{pntemp}

\newcommand{\petrinet}[1]{%
  \begingroup
  \stepcounter{pntemp}%
  %% Nom du fichier temporaire : jobname_pnN.tikz
  \edef\pn@file{\jobname_pn\thepntemp}%
  %% Appel Python via write18 : genere le tikzpicture dans pn@file.tikz
  \immediate\write18{python petri.py #1 > \pn@file.tikz}%
  %% Inclusion du resultat si le fichier existe
  \IfFileExists{\pn@file.tikz}{%
    \input{\pn@file.tikz}%
  }{%
    %% Message d'erreur visible dans le PDF si Python echoue
    \begin{tikzpicture}
      \node[draw=ptErrorColor,text=ptErrorColor,font=\small\ttfamily,
            text width=7cm,align=left,inner sep=6pt] {
        \textbf{PetriTikz -- erreur}\\
        Fichier \pn@file.tikz non cree.\\
        Verifiez : --shell-escape, petritikz.py present,\\
        arguments corrects.
      };
    \end{tikzpicture}%
  }%
  \endgroup
}

\endinput