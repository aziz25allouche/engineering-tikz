%% \petritoken{nœud} : jeton unique au centre
\newcommand{\petritoken}[1]{%
  \fill[ptTokenColor] (#1) circle (2.5pt);
}

%% \petrimark{nœud}{N} : N jetons
\newcommand{\petrimark}[2]{%
  \petritikz@drawtokens{#2}{#1}%
}

%% \petriarc{source}{cible}[poids]
\newcommand{\petriarc}[3][1]{%
  \draw[arc] (#2) -- node[weight]{\ifthenelse{\equal{#1}{1}}{}{#1}} (#3);
}

%% \petriinhibitor{source}{cible}
\newcommand{\petriinhibitor}[2]{%
  \draw[inhibitor] (#1) -- (#2);
}

