\begin{tikzpicture}[petrinet]
  %% Places  (coord. calculees par Python depuis Pre/Post)
  \node[place,label=above:$P_1$] (p0) at (0.0,0.0) {};
  \petritokens{p0}{2}
  \node[place,label=above:$P_2$] (p1) at (5.0,-1.25) {};
  \node[place,label=above:$P_3$] (p2) at (5.0,1.25) {};
  %% Transitions
  \node[transition,label=above:$T_1$] (t0) at (2.5,0.0) {};
  \node[transition,label=above:$T_2$] (t1) at (7.5,-1.25) {};
  \node[transition,label=above:$T_3$] (t2) at (7.5,1.25) {};
  %% Arcs Pre  P->T
  \draw[arc] (p0) --  node[weight]{2} (t0);
  \draw[arc] (p1) --  node[weight]{3} (t1);
  \draw[arc] (p2) --  (t2);
  %% Arcs Post T->P
  \draw[arc] (t0) --  node[weight]{3} (p1);
  \draw[arc] (t0) --  (p2);
  \draw[arc] (t1) to [bend left]  (p0);
  \draw[arc] (t2) to [bend right]  (p0);
\end{tikzpicture}
