\begin{tikzpicture}[
  use US style logic gates,
  every node/.append style={font=\small},
]
  \node[lgin] (I1) at (2.000cm,0.000cm) {$A$};
  \node[lgin] (I2) at (1.200cm,0.000cm) {$B$};
  \node[and gate US,lggate] (G3) at (4.800cm,-1.150cm) {};
  \node[lgin] (I4) at (0.400cm,0.000cm) {$C$};
  \node[or gate US,lggate] (G5) at (7.200cm,-2.875cm) {};
 \draw[lgwire] (I1.south) -- ++(0,-6);
 \draw[lgwire] (I2.south) -- ++(0,-6);
  \draw[lgwire] (I1.output) -- ++(1,0) |- (G3.input 1);
  \draw[lgwire] (I2.output) -- ++(1,0) |- (G3.input 2);
 \draw[lgwire] (I4.south) -- ++(0,-6);
  \draw[lgwire] (G3.output) -- ++(1,0) |- (G5.input 1);
  \draw[lgwire] (I4.output) -- ++(1,0) |- (G5.input 2);
  \node[lgout, right=1.5cm of G5.output]
    (lgoutn) {$S$};
  \draw[lgwireA] (G5.output) -- (lgoutn.west);
\end{tikzpicture}