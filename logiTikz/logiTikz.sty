%%=============================================================
%%  logiTikz.sty  ---  Logigrammes automatiques en LaTeX/TikZ
%%  Version 3.0  (2026)
%%=============================================================
%%
%%  MODE MANUEL (bus vertical + cercles) :
%%    \begin{logigramme}[style=american]{$S$}
%%      \INPUT{$A$}
%%      \INPUT{$B$}
%%      \GATE{g1}{and}{i1}{i2}
%%      \OUT{g1}
%%    \end{logigramme}
%%
%%  MODE AUTO (equation -> logigramme) :
%%    \logicgraph[label=$f$,style=american]{A.B+!C}
%%    (nécessite --shell-escape et python3 + make_lgtikz.py dans le répertoire)
%%
%%  Styles disponibles : american (IEEE, defaut) | european (IEC rectangulaire)
%%  Options  : unit=1.2 (espacement vertical cm), scale=1.0
%%  Portes   : not, and, or, nand, nor, xor, xnor
%%  Syntaxe equation : & ou . (AND), | ou + (OR), ~ ou ! (NOT), ^ (XOR)
%%
%%=============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{logiTikz}[2026/04/12 v3.0 Logic circuit diagrams]

\RequirePackage{tikz}
\RequirePackage{xkeyval}
\RequirePackage{xcolor}

\usetikzlibrary{
  shapes.gates.logic.US,
  shapes.gates.logic.IEC,
  positioning, calc, arrows.meta
}

\makeatletter

%%-------------------------------------------------------------
%% COULEURS
%%-------------------------------------------------------------
\definecolor{lgwire} {RGB}{ 30, 30, 30}
\definecolor{lginf}  {RGB}{200,220,255}
\definecolor{lginb}  {RGB}{ 30, 80,180}
\definecolor{lgoutf} {RGB}{215,245,215}
\definecolor{lgoutb} {RGB}{ 60,150, 50}
\definecolor{lggf}   {RGB}{210,225,255}
\definecolor{lggb}   {RGB}{ 45, 80,170}
\definecolor{lgnotf} {RGB}{255,235,210}
\definecolor{lgnotb} {RGB}{180, 80, 20}

%%-------------------------------------------------------------
%% STYLES TIKZ
%%-------------------------------------------------------------
\tikzset{
  lgwire/.style ={draw=lgwire, line width=0.65pt},
  lgwireA/.style={draw=lgwire, line width=0.65pt, -latex},
  lgbus/.style  ={draw=lgwire, line width=2.0pt},
  lgin/.style={
    draw=lginb, fill=lginf, circle,
    minimum size=5.5mm, inner sep=0pt,
    font=\small\bfseries, text=lginb, line width=0.8pt,
  },
  lgout/.style={
    draw=lgoutb, fill=lgoutf, rectangle, rounded corners=2pt,
    minimum width=1.3cm, minimum height=0.55cm,
    font=\small\bfseries, text=lgoutb, line width=0.8pt,
  },
  lggate/.style={
    draw=lggb, fill=lggf, minimum size=9mm, line width=0.7pt,
  },
  lgnot/.style={
    draw=lgnotb, fill=lgnotf, minimum size=8mm, line width=0.7pt,
  },
}

%%-------------------------------------------------------------
%% OPTIONS (xkeyval)
%%-------------------------------------------------------------
\def\lg@unit{1.2}
\def\lg@scale{1.0}
\def\lg@style{US}    %% US | E  (american | european)

\define@key{logiTikz}{unit}  {\def\lg@unit{#1}}
\define@key{logiTikz}{scale} {\def\lg@scale{#1}}
\define@key{logiTikz}{style} {%
  \def\lg@tmp{#1}%
  \ifx\lg@tmp\lg@opt@eu \def\lg@style{E}\else\def\lg@style{US}\fi
}
\def\lg@opt@eu{european}

%%-------------------------------------------------------------
%% TABLES DE NOMS DE PORTES (via \@namedef — pas de \ifthen dans TikZ)
%%-------------------------------------------------------------
%% Style american (US)
\@namedef{lgg@and@US}{and gate US}
\@namedef{lgg@or@US}{or gate US}
\@namedef{lgg@not@US}{not gate US}
\@namedef{lgg@nand@US}{nand gate US}
\@namedef{lgg@nor@US}{nor gate US}
\@namedef{lgg@xor@US}{xor gate US}
\@namedef{lgg@xnor@US}{xnor gate US}
%% Style european (IEC)
\@namedef{lgg@and@E}{and gate IEC}
\@namedef{lgg@or@E}{or gate IEC}
\@namedef{lgg@not@E}{not gate IEC}
\@namedef{lgg@nand@E}{nand gate IEC}
\@namedef{lgg@nor@E}{nor gate IEC}
\@namedef{lgg@xor@E}{xor gate IEC}
\@namedef{lgg@xnor@E}{xnor gate IEC}
%% Style de remplissage
\@namedef{lgs@and}{lggate}
\@namedef{lgs@or}{lggate}
\@namedef{lgs@not}{lgnot}
\@namedef{lgs@nand}{lggate}
\@namedef{lgs@nor}{lggate}
\@namedef{lgs@xor}{lggate}
\@namedef{lgs@xnor}{lggate}

%%-------------------------------------------------------------
%% \lg@res@gate{type}  ->  \lg@gn (nom tikz),  \lg@gs (style)
%%-------------------------------------------------------------
\def\lg@res@gate#1{%
  \edef\lg@gn{\csname lgg@#1@\lg@style\endcsname}%
  \edef\lg@gs{\csname lgs@#1\endcsname}%
}

%%-------------------------------------------------------------
%% \lg@res@anchor{nodeid}  ->  \lg@oa  (ancre de sortie)
%% iN  -> iN.east  |  autre -> autre.output
%%-------------------------------------------------------------
\def\lg@res@anchor#1{\expandafter\lg@res@anch@i#1\@nil}
\def\lg@res@anch@i#1#2\@nil{%
  \if i#1\edef\lg@oa{#1#2.east}\else\edef\lg@oa{#1#2.output}\fi
}

%%=============================================================
%%  ENVIRONNEMENT logigramme — MODE MANUEL
%%=============================================================
\newcounter{lg@ni}

\newenvironment{logigramme}[2][]{%
  %% --- INIT ---
  \setkeys{logiTikz}{#1}%
  \def\lg@label{#2}%
  \setcounter{lg@ni}{0}%
  \def\lg@lastg{}%
  %% --- OUVERTURE tikzpicture (les macros dessinent directement) ---
  \begin{tikzpicture}[%
    \if E\lg@style
      use IEC style logic gates%
    \else
      use US style logic gates%
    \fi,%
    scale=\lg@scale,%
    every node/.append style={font=\small}%
  ]%
}{%
  %% --- CLOTURE : bus vertical + noeud de sortie ---
  \pgfmathsetmacro{\lg@bb}{-((\value{lg@ni}-1)*\lg@unit+0.45)}%
  \draw[lgbus] (0, 0.45) -- (0, \lg@bb);%
  \ifx\lg@lastg\empty\else
    \node[lgout, right=1.4cm of \lg@lastg.output]
      (lgoutn) {\lg@label};%
    \draw[lgwireA] (\lg@lastg.output) -- (lgoutn.west);%
  \fi
  \end{tikzpicture}%
}

%%-------------------------------------------------------------
%% \INPUT{label}
%%   Cree le noeud d'entree iN sur le bus et son fil horizontal.
%%-------------------------------------------------------------
\newcommand{\INPUT}[1]{%
  \stepcounter{lg@ni}%
  \pgfmathsetmacro{\lg@ix}{-((\value{lg@ni}-1)*\lg@unit)}%
  \node[lgin] (i\the\value{lg@ni}) at (\lg@ix,0) {#1};%
  \draw[lgwire] (i\the\value{lg@ni}.east) -- (\lg@ix, 5.5);%
}

%%-------------------------------------------------------------
%% \UGATE{id}{type}{in}   — porte unaire (NOT, buffer…)
%%-------------------------------------------------------------
\newcommand{\UGATE}[3]{%
  \def\lg@lastg{#1}%
  \lg@res@gate{#2}%
  \lg@res@anchor{#3}%
  \edef\lg@src{\lg@oa}%
  \edef\lg@do{%
    \noexpand\node[\lg@gn, \lg@gs,
      right=1.6cm of \lg@src] (#1) {};%
    \noexpand\draw[lgwire] (\lg@src) -- (#1.input);%
  }%
  \lg@do
}

%%-------------------------------------------------------------
%% \GATE{id}{type}{in1}{in2}   — porte binaire
%%-------------------------------------------------------------
\newcommand{\GATE}[4]{%
  \def\lg@lastg{#1}%
  \lg@res@gate{#2}%
  \lg@res@anchor{#3}\edef\lg@srca{\lg@oa}%
  \lg@res@anchor{#4}\edef\lg@srcb{\lg@oa}%
  \edef\lg@do{%
    \noexpand\node[\lg@gn, \lg@gs,
      at={($(\lg@srca)!0.5!(\lg@srcb)+(2.0cm,0)$)}] (#1) {};%
    \noexpand\draw[lgwire] (\lg@srca) -| (#1.input 1);%
    \noexpand\draw[lgwire] (\lg@srcb) -| (#1.input 2);%
  }%
  \lg@do
}

%%-------------------------------------------------------------
%% \OUT{id}   — designe la porte dont la sortie sera etiquetee
%%-------------------------------------------------------------
\newcommand{\OUT}[1]{\def\lg@lastg{#1}}

%%=============================================================
%%  \logicgraph — MODE AUTOMATIQUE (liaison directe avec Python)
%%
%%  Utilisation :
%%    \logicgraph[label=$S$,style=american]{A.B+!C}
%%    (nécessite --shell-escape et python3 + make_lgtikz.py dans le répertoire)
%%=============================================================
\define@key{logiTikz}{label}{\def\lg@autolabel{#1}}
\def\lg@autolabel{$f$}

\newcounter{lgtemp}

\newcommand{\logicgraph}[2][]{%
  \begingroup
  \setkeys{logiTikz}{#1}%
  \stepcounter{lgtemp}%
  \def\lg@tempfile{\jobname_lg\thelgtemp}%
  \csname write18\endcsname
  \immediate\write18{python3 make_lgtikz.py "#2" "\lg@autolabel" > \lg@tempfile.lgtikz}%
  \IfFileExists{\lg@tempfile.lgtikz}{%
    \input{\lg@tempfile.lgtikz}%
  }{%
    \fbox{%
      \small\ttfamily\color{lggb}%
      Erreur génération graphique logique.\\%
      Vérifiez --shell-escape et présence de make_lgtikz.py.%
    }%
  }%
  \endgroup
}

\makeatother
\endinput