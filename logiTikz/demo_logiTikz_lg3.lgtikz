\begin{tikzpicture}[
  use US style logic gates,
  every node/.append style={font=\small},
]
  \node[lgin] (I1) at (0.000cm,0.000cm) {$A$};
  \node[lgin] (I2) at (1.000cm,0.000cm) {$B$};
  \node[xor gate US,lggate] (G3) at (3.000cm,-1.600cm) {};
  \node[not gate US,lgnot] (G4) at (6.000cm,-1.600cm) {};
  \node[or gate US,lggate] (G5) at (9.000cm,-0.800cm) {};
  \node[lgin] (I6) at (2.000cm,0.000cm) {$C$};
  \node[and gate US,lggate] (G7) at (3.000cm,-4.800cm) {};
  \node[or gate US,lggate] (G8) at (12.000cm,-2.800cm) {};
 \draw[lgwire] (I1.south) -- ++(0,-6);
 \draw[lgwire] (I2.south) -- ++(0,-6);
  \draw[lgwire] (I1.south) -- ++(0,-6) |- (G3.input 1);
  \draw[lgwire] (I2.south) -- ++(0,-6) |- (G3.input 2);
  \draw[lgwire] (G3.east) |- (G4.input);
  \draw[lgwire] (G4.east) -- ++(1,0) |- (G5.input 1);
  \draw[lgwire] (I1.south) -- ++(0,-6) |- (G5.input 2);
 \draw[lgwire] (I6.south) -- ++(0,-6);
  \draw[lgwire] (I6.south) -- ++(0,-6) |- (G7.input 1);
  \draw[lgwire] (I2.south) -- ++(0,-6) |- (G7.input 2);
  \draw[lgwire] (G5.east) -- ++(1,0) |- (G8.input 1);
  \draw[lgwire] (G7.east) -- ++(1,0) |- (G8.input 2);
  \node[lgout, right=1.5cm of G8.output]
    (lgoutn) {$$G$$};
  \draw[lgwireA] (G8.output) -- (lgoutn.west);
\end{tikzpicture}
