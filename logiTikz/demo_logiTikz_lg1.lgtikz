\begin{tikzpicture}[
  use US style logic gates,
  every node/.append style={font=\small},
]
  \node[lgin] (I1) at (0.000cm,0.000cm) {$A$};
  \node[lgin] (I2) at (1.000cm,0.000cm) {$B$};
  \node[and gate US,lggate] (G3) at (3.000cm,-1.600cm) {};
  \node[lgin] (I4) at (2.000cm,0.000cm) {$C$};
  \node[not gate US,lgnot] (G5) at (3.000cm,-6.400cm) {};
  \node[or gate US,lggate] (G6) at (6.000cm,-4.000cm) {};
 \draw[lgwire] (I1.south) -- ++(0,-6);
 \draw[lgwire] (I2.south) -- ++(0,-6);
  \draw[lgwire] (I1.south) -- ++(0,-6) |- (G3.input 1);
  \draw[lgwire] (I2.south) -- ++(0,-6) |- (G3.input 2);
 \draw[lgwire] (I4.south) -- ++(0,-6);
  \draw[lgwire] (I4.south) -- ++(0,-6) |- (G5.input);
  \draw[lgwire] (G3.east) -- ++(1,0) |- (G6.input 1);
  \draw[lgwire] (G5.east) -- ++(1,0) |- (G6.input 2);
  \node[lgout, right=1.5cm of G6.output]
    (lgoutn) {$$S$$};
  \draw[lgwireA] (G6.output) -- (lgoutn.west);
\end{tikzpicture}
