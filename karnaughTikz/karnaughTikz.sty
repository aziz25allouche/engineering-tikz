%% ============================================================
%%  karnaughTikz.sty  --  Tables de Karnaugh avec TikZ
%%  
%%  Version : 1.3 (2026)
%%  Moteur : pdfLaTeX + TikZ + Python 3 (optionnel)
%%  Auteur : Générateur pour engineering-tikz
%% ============================================================
%%
%%  SYNOPSIS :
%%    \begin{karnaugh}[options]{nvars}{variables}{valeurs}
%%      \kvgroup[color]{indices}  ← groupement manuel
%%      \kvautogroup              ← groupement automatique (Python)
%%    \end{karnaugh}
%%
%%  PARAMÈTRES :
%%    nvars    = 2, 3 ou 4 (nombre de variables booléennes)
%%    variables = A,B,C,D (noms des variables)
%%    valeurs  = 1,0,1,X,... (en ordre MINTERM 0..2^nvars-1)
%%
%%  OPTIONS :
%%    cell = 1cm        taille d'une cellule (défaut 1cm)
%%    index = false     afficher les indices minterms (défaut false)
%%
%%  DÉPENDANCES :
%%    \kvautogroup requiert : pdflatex -shell-escape + Python 3 + logique_karnaugh.py
%%
%%  EXEMPLE :
%%    \begin{karnaugh}[cell=0.8cm,index=true]{4}{A,B,C,D}{1,0,1,1,X,0,1,0,1,1,0,X,1,0,1,1}
%%      \kvautogroup  %% Calcule les groupements automatiquement avec Python
%%    \end{karnaugh}
%%
%% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{karnaughTikz}[2026/03/01 v1.3 Tables de Karnaugh TikZ]

%% ─────────────────────────────────────────────────────────────────────────────
%% PAQUETS REQUIS
%% ─────────────────────────────────────────────────────────────────────────────
\RequirePackage{tikz}      %% Élément graphique pour dessiner les rectangles
\RequirePackage{xkeyval}   %% Traitement des options clé=valeur
\RequirePackage{xcolor}    %% Gestion des couleurs (red!60, blue!60, etc.)
\RequirePackage{pgffor}    %% Boucles \foreach pour itérer sur cellules/valeurs
\usetikzlibrary{calc}      %% Calculs de coordonnées TikZ

%% ─────────────────────────────────────────────────────────────────────────────
%% DÉCLARATION DES OPTIONS
%% ─────────────────────────────────────────────────────────────────────────────
%% Les utilisateurs peuvent spécifier [cell=0.8cm,index=true] dans l'environnement

\define@key{karnaugh}{cell} {\def\kvcell{#1}}  %% Option : taille cellule
\define@key{karnaugh}{index}{\def\kvindex{#1}} %% Option : afficher indices minterms
\makeatletter
\define@key{kvgroup}{wrapr}[false]{\def\kvwrapr{#1}}
\define@key{kvgroup}{wrapc}[false]{\def\kvwrapc{#1}}
\define@key{kvgroup}{color}{\def\kvgroupcolor{#1}}
\makeatother

%% VALEURS PAR DÉFAUT
\def\kvcell{1cm}      %% Taille par défaut = 1cm × 1cm
\def\kvindex{false}   %% N'affiche pas les indices par défaut
\def\kvindextrue{true}  %% Comparaison pour vérifier true

%% ─────────────────────────────────────────────────────────────────────────────
%% COMPTEURS INTERNES
%% ─────────────────────────────────────────────────────────────────────────────
%% Utilisés pour stocker dimensions et itérer sur grille

\newcounter{kvnv}      %% nb de variables (2, 3 ou 4)
\newcounter{kvnr}      %% nb de LIGNES dans la grille
\newcounter{kvnc}      %% nb de COLONNES dans la grille
\newcounter{kvii}      %% itérateur générique pour boucles
\newcounter{kvcellidx} %% index minterm courant (0 .. 2^nvars-1)

%% ─────────────────────────────────────────────────────────────────────────────
%% STOCKAGE DES VALEURS BOOLÉENNES
%% ─────────────────────────────────────────────────────────────────────────────
%% Chaque minterm (0..15) a sa valeur (0, 1, ou X) stockée dans \kvv@N
%% Exemple : \kvv@5 → contient '1' ou '0' ou 'X' pour minterm 5
%% 
%% \kvgetv{5} → retourne le contenu de \kvv@5
%% 
%% CORRECTIF IMPORTANT : On utilise \xdef au lieu de \edef pour développer
%% complètement la variable \kvtmpv avant de la stocker (sinon expansion tardive)

\def\kvgetv#1{\csname kvv@#1\endcsname}
  %% Accès générique : récupère \kvv@N par construction dynamique de commandes

\def\kvparsevals#1{%
  %% Parse la liste des valeurs séparées par virgules
  %% Crée des macros \kvv@0, \kvv@1, ..., \kvv@15 avec les valeurs
  \setcounter{kvii}{0}%
  \foreach \kvtmpv in {#1}{%
    %% Pour chaque élément dans la liste (séparé par virgule)
    \expandafter\xdef\csname kvv@\thekvii\endcsname{\kvtmpv}%
      %% \xdef = edef GLOBALE (développement complet avant stockage)
      %% \csname kvv@\thekvii\endcsname = construit dynamiquement \kvv@0, \kvv@1...
    \stepcounter{kvii}%
      %% Incrémente le compteur pour minterm suivant
  }%
}

%% ─────────────────────────────────────────────────────────────────────────────
%% NOMS DES VARIABLES BOOLÉENNES
%% ─────────────────────────────────────────────────────────────────────────────
%% Parse la liste des noms des variables (A, B, C, D) et les stocke
%% dans \kvvVarA, \kvvVarB, \kvvVarC, \kvvVarD
%% Ces noms seront affichés dans les en-têtes de la grille

\def\kvparsevars#1{%
  %% Parse la liste des noms de variables séparées par virgules
  \setcounter{kvii}{0}%
  \foreach \kvvar in {#1}{%
    %% Pour chaque variable dans la liste
    \stepcounter{kvii}%
      %% Incrémente le compteur (1ère = A, 2e = B, etc.)
    \ifnum\thekvii=1\xdef\kvvVarA{\kvvar}\fi
      %% Si compteur == 1 → stocke dans \kvvVarA
    \ifnum\thekvii=2\xdef\kvvVarB{\kvvar}\fi
      %% Si compteur == 2 → stocke dans \kvvVarB
    \ifnum\thekvii=3\xdef\kvvVarC{\kvvar}\fi
      %% Si compteur == 3 → stocke dans \kvvVarC
    \ifnum\thekvii=4\xdef\kvvVarD{\kvvar}\fi
      %% Si compteur == 4 → stocke dans \kvvVarD
  }%
}

%% ─────────────────────────────────────────────────────────────────────────────
%% TABLES DE CONVERSION - CODE GRAY
%% ─────────────────────────────────────────────────────────────────────────────
%% En Karnaugh, l'ordre d'affichage du code Gray est crucial pour que
%% les adjacences logiques correspondent aux adjacences géométriques.
%% 
%% \kvgray{i} : position affichage i → indice Gray
%%   Entrée : 0,1,2,3 (position visuelle à l'écran)
%%   Sortie : stored in \kvG comme 0,1,3,2 (ordre Gray)
%%
%% \kvgrayinv{i} : indice Gray i → position affichage (table inverse)
%%   Entrée : 0,1,3,2 (minterm avec 2 bits Gray)
%%   Sortie : stored in \kvGi comme position 0,1,2,3 pour affichage
%%
%% Exemple : minterm 5 = (1)(01 in binary)
%%   → son code Gray pour colonne est 01 → position Gray inverse → col 1

\def\kvgray#1{%
  %% Définit \kvG selon la position (0,1,2,3) → code Gray (0,1,3,2)
  \ifcase#1\relax
    \def\kvG{0}\or\def\kvG{1}\or\def\kvG{3}\or\def\kvG{2}\fi%
}

\def\kvgrayinv#1{%
  %% Inverse : convertit code Gray (0,1,3,2) → position affichage (0,1,2,3)
  \ifcase#1\relax
    \def\kvGi{0}\or\def\kvGi{1}\or\def\kvGi{3}\or\def\kvGi{2}\fi%
}

%% ─────────────────────────────────────────────────────────────────────────────
%% CONVERSION : (pos_ligne, pos_col) → minterm
%% ─────────────────────────────────────────────────────────────────────────────
%% Calcule le numéro minterm à partir d'une position d'affichage (row, col)
%% 
%% Résultat stocké dans \kvmin
%%
%% Formules selon nvars :
%%   nvars=2 : minterm = row*2 + col                (simple, pas de Gray)
%%   nvars=3 : minterm = row*4 + GRAY2[col]         (colonnes en Gray)
%%   nvars=4 : minterm = GRAY2[row]*4 + GRAY2[col]  (lignes et colonnes Gray)

\def\kvrctomn#1#2{%
  %% #1 = row (position ligne), #2 = col (position colonne)
  %% Calcule minterm selon nvars
  \ifnum\thekvnv=2
    %% 2 variables : grille 2×2, indices simples
    \pgfmathtruncatemacro{\kvmin}{#1*2 + #2}%
  \fi
  \ifnum\thekvnv=3
    %% 3 variables : grille 2×4, colonnes en code Gray
    \kvgrayinv{#2}\edef\kvGtmp{\kvGi}%
      %% Convertit position colonne affichage → indice Gray
    \pgfmathtruncatemacro{\kvmin}{#1*4 + \kvGtmp}%
      %% minterm = ligne*4 + colonne_gray
  \fi
  \ifnum\thekvnv=4
    %% 4 variables : grille 4×4, lignes ET colonnes en code Gray
    \kvgrayinv{#1}\edef\kvGrow{\kvGi}%
      %% Convertit position ligne → indice Gray
    \kvgrayinv{#2}\edef\kvGcol{\kvGi}%
      %% Convertit position colonne → indice Gray
    \pgfmathtruncatemacro{\kvmin}{\kvGrow*4 + \kvGcol}%
      %% minterm = (ligne_gray)*4 + (colonne_gray)
  \fi
}

%% ─────────────────────────────────────────────────────────────────────────────
%% CONVERSION : minterm → (pos_ligne, pos_col)
%% ─────────────────────────────────────────────────────────────────────────────
%% Calcule la position d'affichage à partir d'un minterm
%% 
%% Résultats : \kvrow et \kvcol
%%
%% Formules (inverses) :
%%   nvars=2 : row = minterm/2, col = minterm%2
%%   nvars=3 : row = minterm/4, col = GRAY2[minterm%4]
%%   nvars=4 : row = GRAY2[minterm/4], col = GRAY2[minterm%4]

\def\kvmintorc#1{%
  %% #1 = minterm (numéro 0..2^nvars-1) ordre gray
  % suppression de l'ordre gray pour calcul de la position d'affichage

  %% Calcule position d'affichage
  \ifnum\thekvnv=2
    %% 2 variables : conversion simple (pas Gray)
    \pgfmathtruncatemacro{\kvrow}{#1/2}%
      %% Ligne = minterm ÷ 2 (entier)
    \pgfmathtruncatemacro{\kvcol}{mod(#1,2)}%
      %% Colonne = minterm modulo 2
  \fi
  \ifnum\thekvnv=3
    %% 3 variables : colonnes Gray
    \pgfmathtruncatemacro{\kvrow}{#1/4}%
      %% Ligne = minterm ÷ 4 (entier)
    \pgfmathtruncatemacro{\kvctmp}{mod(#1,4)}%
      %% inverse de gray pour les colonnes : minterm modulo 4 → indice Gray
    \kvgrayinv{\kvctmp}\edef\kvcol{\kvGi}%
      %% Convertit bits bas → position colonne Gray
  \fi
  \ifnum\thekvnv=4
    %% 4 variables : lignes ET colonnes Gray
    \pgfmathtruncatemacro{\kvrtmp}{#1/4}%
      %% Bits hauts du minterm
    \pgfmathtruncatemacro{\kvctmp}{mod(#1,4)}%
      %% Bits bas du minterm
    \kvgrayinv{\kvrtmp}\edef\kvrow{\kvGi}%
      %% Bits hauts → position ligne Gray
    \kvgrayinv{\kvctmp}\edef\kvcol{\kvGi}%
      %% Bits bas → position colonne Gray
  \fi
}

%% ─────────────────────────────────────────────────────────────────────────────
%% DESSIN DE LA GRILLE ET DES CELLULES
%% ─────────────────────────────────────────────────────────────────────────────
%% Parcourt toutes les positions d'affichage (row, col) de la grille
%% Pour chaque position :
%%   1. Dessine un carré (cellule)
%%   2. Convertit en minterm et récupère la valeur (0, 1 ou X)
%%   3. Affiche la valeur au centre de la cellule
%%   4. (Optionnel) Affiche l'indice minterm en petit en haut-gauche

\def\kvdrawgrid{%
  %% Calcule les limites pour les boucles (0 à nr-1, 0 à nc-1)
  \pgfmathtruncatemacro{\kvnrm}{\thekvnr-1}%
    %% kvnrm = nombre de lignes - 1 (pour boucle JUSQU'À kvnrm)
  \pgfmathtruncatemacro{\kvncm}{\thekvnc-1}%
    %% kvncm = nombre de colonnes - 1
  
  %% Boucle sur toutes les lignes et colonnes
  \foreach \kvrr in {0,...,\kvnrm}{%    %% kvrr = numéro ligne (0..nr-1)
    \foreach \kvcc in {0,...,\kvncm}{%  %% kvcc = numéro colonne (0..nc-1)
      %% ÉTAPE 1 : Dessine la cellule (carré noir vide)
      \draw[black, line width=0.4pt]
        ({\kvcc*\kvpt},{-\kvrr*\kvpt})                %% coin supérieur-gauche
        rectangle ({(\kvcc+1)*\kvpt},{-(\kvrr+1)*\kvpt});  %% coin inférieur-droit
        %% Note : -\kvrr car y écran va vers le bas (négatif en TikZ)
      
      %% ÉTAPE 2 : Convertit position affichage (kvrr,kvcc) → minterm
      \kvrctomn{\kvrr}{\kvcc}%
        %% Résultat dans \kvmin
      \edef\kvthismin{\kvmin}%
        %% Stocke dans \kvthismin pour utilisation ultérieure
      
      %% ÉTAPE 3 : Récupère et affiche la valeur booléenne (0, 1 ou X)
      \node[font=\normalsize] at
        ({(\kvcc+0.5)*\kvpt},{-(\kvrr+0.5)*\kvpt})  %% centre de la cellule
        {\kvgetv{\kvthismin}};  %% affiche la valeur (0/1/X)
      
      %% ÉTAPE 4 : Affiche optionnellement l'indice minterm (petit, coin supérieur-gauche)
      \ifx\kvindex\kvindextrue
        %% Si option index=true
        \node[font=\tiny, anchor=north west, text=gray] at
          ({\kvcc*\kvpt+1pt},{-\kvrr*\kvpt-1pt}) %% coin nord-ouest (avec petit décalage)
          {\kvthismin};  %% affiche l'indice minterm
      \fi%
    }%
  }%
  
  %% Contour épais autour de la grille (pour cadre distinctif)
  \draw[black, line width=1pt]
    (0,0) rectangle ({\thekvnc*\kvpt},{-\thekvnr*\kvpt});%
}

%% ─────────────────────────────────────────────────────────────────────────────
%% AFFICHAGE DES EN-TÊTES (colonne & ligne avec noms variables et valeurs binaires)
%% ─────────────────────────────────────────────────────────────────────────────
%% Affiche les en-têtes selon le nombre de variables.
%% 
%% Pour 2 variables : en-tête simple
%%   Colonnes : B (0,1)
%%   Lignes : A (0,1)
%%
%% Pour 3 variables : 
%%   Colonnes : BC (00,01,11,10) en code Gray
%%   Lignes : A (0,1)
%%
%% Pour 4 variables :
%%   Colonnes : CD (00,01,11,10) en code Gray
%%   Lignes : AB (00,01,11,10) en code Gray

\def\kvdrawheaders{%
  %% Diagonal line connecting corner labels (aesthetics)
  \draw (0,0) -- ({-0.5*\kvpt},{0.5*\kvpt});%
  
  \ifnum\thekvnv=2
    %% CAS 2 VARIABLES (grille 2×2)
    %% En-tête colonne : simple 0,1 (pas Gray)
    \node[anchor=south] at ({\kvpt},2pt) {\small\bfseries\kvvVarB};%
      %% Affiche "B" au-dessus de la grille
    \node[anchor=east]  at (-2pt,{-\kvpt}) {\small\bfseries\kvvVarA};%
      %% Affiche "A" à gauche de la grille
    
    %% Valeurs des colonnes
    \foreach \kvc/\kvl in {0/0,1/1}{%
      %% \kvc = numéro colonne, \kvl = label (0 ou 1)
      \node[anchor=south,font=\tiny] at ({(\kvc+0.5)*\kvpt},0) {\kvl};}%
    
    %% Valeurs des lignes
    \foreach \kvr/\kvl in {0/0,1/1}{%
      %% \kvr = numéro ligne, \kvl = label (0 ou 1)
      \node[anchor=east,font=\tiny] at (0,{-(\kvr+0.5)*\kvpt}) {\kvl};}%
  \fi
  
  \ifnum\thekvnv=3
    %% CAS 3 VARIABLES (grille 2×4)
    %% Colonnes : 2 variables (BC) → 4 valeurs en code Gray
    \node[anchor=south] at ({2*\kvpt},2pt) {\small\bfseries\kvvVarB\kvvVarC};%
      %% Affiche "BC" au-dessus (2 cellules = largeur 2*kvpt)
    \node[anchor=east]  at (-2pt,{-\kvpt}) {\small\bfseries\kvvVarA};%
      %% Affiche "A" à gauche (1 cellule = hauteur 1*kvpt)
    
    %% Valeurs des colonnes en code GRAY (00, 01, 11, 10)
    \foreach \kvc/\kvl in {0/00,1/01,2/11,3/10}{%
      %% Position colonne 0-3, label en Gray
      \node[anchor=south,font=\tiny] at ({(\kvc+0.5)*\kvpt},0) {\kvl};}%
    
    %% Valeurs des lignes (simple : 0, 1)
    \foreach \kvr/\kvl in {0/0,1/1}{%
      %% 2 lignes seulement
      \node[anchor=east,font=\tiny] at (0,{-(\kvr+0.5)*\kvpt}) {\kvl};}%
  \fi
  
  \ifnum\thekvnv=4
    %% CAS 4 VARIABLES (grille 4×4)
    %% Colonnes : 2 variables (CD) → 4 valeurs en code Gray
    \node[anchor=south] at ({2*\kvpt},2pt) {\small\bfseries\kvvVarC\kvvVarD};%
      %% Affiche "CD" au-dessus
    \node[anchor=east]  at (-2pt,{-2*\kvpt}) {\small\bfseries\kvvVarA\kvvVarB};%
      %% Affiche "AB" à gauche (2 cellules de hauteur = 2*kvpt)
    
    %% Valeurs des colonnes en code GRAY (CD : 00, 01, 11, 10)
    \foreach \kvc/\kvl in {0/00,1/01,2/11,3/10}{%
      \node[anchor=south,font=\tiny] at ({(\kvc+0.5)*\kvpt},0) {\kvl};}%
    
    %% Valeurs des lignes en code GRAY (AB : 00, 01, 11, 10)
    \foreach \kvr/\kvl in {0/00,1/01,2/11,3/10}{%
      \node[anchor=east,font=\tiny] at (0,{-(\kvr+0.5)*\kvpt}) {\kvl};}%
  \fi
}

%% ─────────────────────────────────────────────────────────────────────────────
%% COMMANDE : \kvgroup[color]{indices}
%% 
%% Dessine un rectangle englobant autour des cellules spécifiées.
%% Gère automatiquement le wrap torique (rectangle peut passer par les bords).
%% 
%% Syntaxe :
%%   \kvgroup[blue!60]{2,3,6,7}  → rectangle autour des minterms 2,3,6,7
%%   \kvgroup{0,1,4,5}           → couleur défaut (red!70)
%%
%% Algorithme :
%%   1. Pour chaque minterm : convertit en position affichage (row, col)
%%   2. Trouve les bornes : min/max lignes et colonnes
%%   3. Calcule les différences (span)
%%   4. Détecte le cas de wrap torique (4 coins)
%%   5. Dessine le (ou les) rectangle(s) avec couleur et transparence
%%
%% GESTION DU WRAP TORIQUE :
%%   Cas normal : 1 rectangle simple
%%   Cas 4 coins : si la sélection couvre les 4 coins de la grille,
%%                dessine 4 petits rectangles aux coins (pour visualiser le wrap)
%% ─────────────────────────────────────────────────────────────────────────────

%% ─────────────────────────────────────────────────────────────────────────────
%% ─────────────────────────────────────────────────────────────────────────────
%% COMMANDE : \kvgroup{couleur}{wrapr}{wrapc}{indices}
%%
%% Syntaxe produite par logique_karnaugh.py (4 arguments obligatoires) :
%%   \kvgroup{red!60}{false}{false}{0,1,2,3}    ← rectangle simple
%%   \kvgroup{blue!60}{true}{false}{0,8}         ← wrap vertical (haut+bas)
%%   \kvgroup{green!60}{false}{true}{0,2,4,6}    ← wrap horizontal (gauche+droit)
%%   \kvgroup{orange!70}{true}{true}{0,2,8,10}   ← wrap double (4 coins)
%%
%% Arguments :
%%   #1 = couleur TikZ  ex: red!60
%%   #2 = wrapr         "true" ou "false"  (wrap vertical)
%%   #3 = wrapc         "true" ou "false"  (wrap horizontal)
%%   #4 = indices       liste minterms séparés par virgules
%%
%% Logique de dessin :
%%   false/false → 1 rectangle simple
%%   true/false  → 2 rectangles (bords haut + bas)
%%   false/true  → 2 rectangles (bords gauche + droit)
%%   true/true   → 4 rectangles aux 4 coins
%% ─────────────────────────────────────────────────────────────────────────────

\newcommand{\kvgroup}[4]{%
  %% #1=couleur  #2=wrapr(true/false)  #3=wrapc(true/false)  #4=minterms
  \def\kvgroupcolor{#1}%
  \def\kvwrapr{#2}%
  \def\kvwrapc{#3}%
  \def\kvtrue{true}%

  %% ── Calcul des bornes via mapping Gray (\kvmintor)──────────────────────
  \def\kvrmin{99}\def\kvrmax{0}%
  \def\kvcmin{99}\def\kvcmax{0}%
  \foreach \kvm in {#4}{%
    \kvmintorc{\kvm}%
    \ifnum\kvrow<\kvrmin\xdef\kvrmin{\kvrow}\fi
    \ifnum\kvrow>\kvrmax\xdef\kvrmax{\kvrow}\fi
    \ifnum\kvcol<\kvcmin\xdef\kvcmin{\kvcol}\fi
    \ifnum\kvcol>\kvcmax\xdef\kvcmax{\kvcol}\fi
  }%
  \edef\kvRmin{\kvrmin}\edef\kvRmax{\kvrmax}%
  \edef\kvCmin{\kvcmin}\edef\kvCmax{\kvcmax}%

  %% ── Dispatch selon wrapr/wrapc ───────────────────────────────────────────
  \ifx\kvwrapr\kvtrue
    \ifx\kvwrapc\kvtrue
      %% CAS WRAP DOUBLE (true/true) : 4 rectangles aux coins
      \pgfmathtruncatemacro{\kvlastrow}{\thekvnr-1}%
      \pgfmathtruncatemacro{\kvlastcol}{\thekvnc-1}%
      \kvdrawrect{\kvCmin}{0}{\kvCmax}{\kvRmin}%           %% haut-centre
      \kvdrawrect{0}{0}{\kvCmin}{\kvRmin}%                 %% haut-gauche
      \kvdrawrect{\kvCmin}{\kvRmax}{\kvCmax}{\kvlastrow}%  %% bas-centre
      \kvdrawrect{0}{\kvRmax}{\kvCmin}{\kvlastrow}%        %% bas-gauche
    \else
      %% CAS WRAP VERTICAL (true/false) : 2 rectangles haut+bas
      \pgfmathtruncatemacro{\kvlastrow}{\thekvnr-1}%
      \kvdrawrect{\kvCmin}{0}{\kvCmax}{\kvRmin}%           %% bande du haut
      \kvdrawrect{\kvCmin}{\kvRmax}{\kvCmax}{\kvlastrow}%  %% bande du bas
    \fi
  \else
    \ifx\kvwrapc\kvtrue
      %% CAS WRAP HORIZONTAL (false/true) : 2 rectangles gauche+droit
      \pgfmathtruncatemacro{\kvlastcol}{\thekvnc-1}%
      \kvdrawrect{0}{\kvRmin}{\kvCmin}{\kvRmax}%           %% bande gauche
      \kvdrawrect{\kvCmax}{\kvRmin}{\kvlastcol}{\kvRmax}%  %% bande droite
    \else
      %% CAS NORMAL (false/false) : 1 seul rectangle
      \kvdrawrect{\kvCmin}{\kvRmin}{\kvCmax}{\kvRmax}%
    \fi
  \fi
}

%% Primitive interne : rectangle arrondi semi-transparent
%% #1:col_min  #2:row_min  #3:col_max  #4:row_max
\newcommand{\kvdrawrect}[4]{%
  \draw[\kvgroupcolor, fill=\kvgroupcolor, fill opacity=0.18,
        line width=1.2pt, rounded corners=5pt]
    ({#1*\kvpt+3pt},{-#2*\kvpt-3pt})
    rectangle
    ({(#3+1)*\kvpt-3pt},{-(#4+1)*\kvpt+3pt});%
}


%% ─────────────────────────────────────────────────────────────────────────────
%% COMMANDE : \kvautogroup
%%
%% Groupement AUTOMATIQUE via Python et l'algorithme greedy.
%% 
%% Fonctionnement :
%%   1. Appelle Python pour résoudre le tableau de Karnaugh
%%   2. Python retourne les commandes \kvgroup[color]{indices}
%%   3. Insère ces commandes dans le document LaTeX
%%
%% PRÉREQUIS :
%%   - Compiler avec : pdflatex -shell-escape
%%   - Python 3 doit être installé
%%   - Fichier logique_karnaugh.py dans le répertoire courant
%%
%% SÉCURITÉ :
%%   Le flag -shell-escape permet à LaTeX d'exécuter des commandes système
%%   (ici : python3 logique_karnaugh.py ...). À utiliser avec prudence.
%%
%% OUTPUT :
%%   La sortie Python est capturée dans un fichier temporaire kv_tmp.tex
%%   Si le fichier existe, il est inséré (\input).
%% ─────────────────────────────────────────────────────────────────────────────

\newcommand{\kvautogroup}{%
  %% Exécute Python et capture la sortie
  %% Arguments : nvars, valeurs séparées par virgules
  %% Output : fichier kv_tmp.tex contenant les commandes \kvgroup
  \immediate\write18{python3 logique_karnaugh.py \thekvnv\space
    "\kvCurrentVals" > kv_tmp.tex}%
  
  %% Insère le fichier généré s'il existe
  \IfFileExists{kv_tmp.tex}{\input{kv_tmp.tex}}{}%
}

%% ─────────────────────────────────────────────────────────────────────────────
%% ENVIRONNEMENT : karnaugh
%%
%% Interface principale pour créer un tableau de Karnaugh.
%%
%% SYNTAXE :
%%   \begin{karnaugh}[options]{nvars}{variables}{valeurs}
%%     \kvgroup[color]{indices}   ← contrôle manuel
%%     ou
%%     \kvautogroup               ← calcul automatique
%%   \end{karnaugh}
%%
%% PARAMÈTRES OBLIGATOIRES :
%%   {nvars}   = nombre de variables (2, 3 ou 4)
%%   {variables} = noms séparés par virgules (A,B,C,D)
%%   {valeurs}   = valeurs séparées par virgules en ordre MINTERM
%%
%% VALEURS AUTORISÉES :
%%   0  = zéro (cellule blanche)
%%   1  = un (cellule à grouper)
%%   X  = don't care (peut être 0 ou 1, utilisable pour élargir les groupes)
%%
%% OPTIONS (optionnelles) :
%%   cell = 1cm    taille de chaque cellule (défaut 1cm)
%%   index = false afficher les indices des minterms (défaut false)
%%           true  affiche les numéros 0-15 en petit
%%
%% EXEMPLE :
%%   \begin{karnaugh}[cell=0.8cm,index=true]{4}{A,B,C,D}{1,0,1,X,1,0,0,1,X,X,1,0,1,0,1,1}
%%     \kvautogroup
%%   \end{karnaugh}
%%
%% SÉQUENCE D'EXÉCUTION :
%%   1. Parse les options [cell, index]
%%   2. Parse nvars → détermine dimensions grille
%%   3. Parse variables → stocke les noms A,B,C,D
%%   4. Parse valeurs → stocke 0/1/X pour chaque minterm
%%   5. Crée environnement TikZ
%%   6. Dessine grille + en-têtes
%%   7. L'utilisateur ajoute \kvgroup ou \kvautogroup
%%   8. Ferme TikZ et corrige l'affichage
%% ─────────────────────────────────────────────────────────────────────────────

\newenvironment{karnaugh}[4][]{%
  %% OUVERTURE : Initialisation de l'environnement
  
  %% Initialise les valeurs par défaut des options
  \def\kvcell{1cm}\def\kvindex{false}%
  
  %% Parse les options fournies par l'utilisateur (cell=..., index=...)
  \setkeys{karnaugh}{#1}%
  
  %% Convertit kvcell (ex: "1cm") en nombre de points pour calcul TikZ
  %% kvpt est utilisé pour toutes les dimensions dans les dessins
  \pgfmathsetmacro{\kvpt}{\kvcell/1pt}%
  
  %% ÉTAPE 1 : Détermine la dimension de la grille selon nvars
  %% Stocke dans les compteurs kvnv (nb variables), kvnr (nb lignes), kvnc (nb colonnes)
  \setcounter{kvnv}{#2}%  %% #2 = nombre de variables
  \ifnum\thekvnv=2\setcounter{kvnr}{2}\setcounter{kvnc}{2}\fi
    %% nvars=2 → grille 2×2 (4 cellules)
  \ifnum\thekvnv=3\setcounter{kvnr}{2}\setcounter{kvnc}{4}\fi
    %% nvars=3 → grille 2×4 (8 cellules)
  \ifnum\thekvnv=4\setcounter{kvnr}{4}\setcounter{kvnc}{4}\fi
    %% nvars=4 → grille 4×4 (16 cellules)
  
  %% ÉTAPE 2 : Parse les noms des variables (A,B,C,D)
  \kvparsevars{#3}%  %% #3 = liste variables
  
  %% ÉTAPE 3 : Parse les valeurs booléennes (0,1,X,...)
  \kvparsevals{#4}%  %% #4 = liste valeurs
  
  %% Stocke la chaîne complète des valeurs pour \kvautogroup (Python)
  \xdef\kvCurrentVals{#4}%
  
  %% ÉTAPE 4 : Crée l'environnement TikZ pour le dessin
  \begin{tikzpicture}[x=1pt,y=1pt]%
    %% x=1pt, y=1pt : rend les coordonnées en points pour précision
    
    %% Dessine la grille et les cellules avec les valeurs
    \kvdrawgrid%
    
    %% Dessine les en-têtes (variables et indices)
    \kvdrawheaders%
}{%
  %% FERMETURE : Termine l'environnement TikZ
  \end{tikzpicture}%
}

